---
import { SITE } from '../consts';

const bannerChars = 'TAFFY'.split('');
---

<section class="home-intro" aria-labelledby="intro-name">
  <div class="home-intro__bg" aria-hidden="true"></div>
  <div class="home-intro__grid" aria-hidden="true"></div>

  <div class="home-intro__stage">
    <div class="intro-banner" aria-hidden="true">
      <span class="intro-line intro-line--top"></span>
      <div class="intro-banner__chars">
        {
          bannerChars.map((char, index) => (
            <span class="intro-char" style={`--i:${index}`}>
              {char}
            </span>
          ))
        }
      </div>
      <span class="intro-line intro-line--bottom"></span>
    </div>

    <div class="intro-profile">
      <div class="intro-profile__avatar-wrap">
        <span class="intro-burst" aria-hidden="true">
          {
            Array.from({ length: 8 }).map((_, index) => (
              <span
                class="intro-ray"
                style={`--a:${index * 45}deg;--i:${index}`}
              />
            ))
          }
        </span>

        <img
          class="intro-profile__avatar"
          src="/avatar.png"
          alt={`${SITE.name} 的头像`}
          width="112"
          height="112"
        />
        <span class="intro-profile__status" title="在线">☁️</span>
      </div>

      <p class="intro-profile__eyebrow">Study · Life · Notes</p>
      <h1 class="intro-profile__name" id="intro-name">{SITE.name}</h1>
      <p class="intro-profile__handle">@{SITE.handle}</p>
      <p class="intro-profile__bio">
        写代码，也记录生活。<br />
        这里放学习笔记、项目记录，和一些生活片段。
      </p>

      <div class="intro-profile__social">
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
        <span aria-hidden="true">·</span>
        <a href="/rss.xml">RSS</a>
        <span aria-hidden="true">·</span>
        <a href="/tags/">标签</a>
      </div>

      <nav class="intro-profile__actions" aria-label="首页导航">
        <a class="button" href="/blog/">看动态</a>
        <a class="button button--ghost" href="/about/">关于我</a>
      </nav>

      <div class="intro-hud" aria-hidden="true">
        <span><b>STATUS</b> ONLINE</span>
        <span><b>NODE</b> TAFFY</span>
        <span><b>LINK</b> STABLE</span>
      </div>
    </div>
  </div>

  <a class="intro-scroll" href="#latest-life" aria-label="Scroll 向下滚动到最近动态">
    <span>Scroll</span>
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </a>
</section>

<style>
  .home-intro {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100svh - 96px);
    overflow: hidden;
    isolation: isolate;
    background: transparent;
  }

  .home-intro__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        45% 55% at 20% 30%,
        rgba(255, 179, 209, 0.42),
        transparent 70%
      ),
      radial-gradient(
        45% 50% at 80% 18%,
        rgba(108, 201, 255, 0.32),
        transparent 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 250, 255, 0.7),
        rgba(241, 247, 255, 0.84)
      ),
      var(--theme-hero-image) center / cover no-repeat;
    animation: bg-in 1.4s ease both;
  }

  :global([data-theme="dark"]) .home-intro__bg {
    background:
      radial-gradient(
        45% 55% at 20% 30%,
        rgba(0, 229, 255, 0.12),
        transparent 70%
      ),
      radial-gradient(
        45% 50% at 80% 18%,
        rgba(255, 176, 32, 0.1),
        transparent 70%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 10, 0.55),
        rgba(5, 6, 10, 0.9)
      ),
      var(--theme-hero-image) center / cover no-repeat;
  }

  :global([data-theme="dark"]) .home-intro::before {
    content: "";
    position: absolute;
    inset: 18px;
    z-index: 2;
    pointer-events: none;
    opacity: 0.5;
    background:
      linear-gradient(var(--accent), var(--accent)) left top / 30px 1px
        no-repeat,
      linear-gradient(var(--accent), var(--accent)) left top / 1px 30px
        no-repeat,
      linear-gradient(var(--accent-2), var(--accent-2)) right bottom / 30px 1px
        no-repeat,
      linear-gradient(var(--accent-2), var(--accent-2)) right bottom / 1px 30px
        no-repeat;
  }

  .home-intro::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
  }

  :global([data-theme="dark"]) .home-intro::after {
    opacity: 0.16;
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.06) 0 1px,
      transparent 1px 4px
    );
  }

  .home-intro__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      rgba(139, 92, 246, 0.24) 1px,
      transparent 1.4px
    );
    background-size: 26px 26px;
    mask-image: radial-gradient(
      ellipse at 50% 42%,
      black 10%,
      transparent 72%
    );
    opacity: 0.7;
    animation: grid-in 1.8s 0.15s ease both;
  }

  :global([data-theme="dark"]) .home-intro__grid {
    background-image:
      linear-gradient(rgba(0, 229, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 229, 255, 0.08) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(
      ellipse at 50% 45%,
      black 10%,
      transparent 75%
    );
    opacity: 1;
  }

  .home-intro__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: inherit;
    padding: 72px 24px 96px;
  }

  .intro-banner,
  .intro-profile {
    grid-area: 1 / 1;
  }

  /* The vertical type intro */
  .intro-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    animation: banner-out 0.42s 1.3s cubic-bezier(0.4, 0, 1, 1) both;
  }

  .intro-line {
    display: block;
    width: 1px;
    height: 0;
    background: linear-gradient(
      180deg,
      var(--accent-2),
      var(--accent-3)
    );
    box-shadow: 0 0 14px rgba(255, 143, 190, 0.55);
  }

  :global([data-theme="dark"]) .intro-line {
    background: linear-gradient(
      180deg,
      var(--accent),
      var(--accent-2)
    );
    box-shadow: 0 0 14px rgba(0, 229, 255, 0.55);
  }

  .intro-line--top {
    animation: line-grow 0.6s 0.05s cubic-bezier(0.22, 1, 0.36, 1) both;
    transform-origin: bottom;
  }

  .intro-line--bottom {
    animation: line-grow 0.6s 0.05s cubic-bezier(0.22, 1, 0.36, 1) both;
    transform-origin: top;
  }

  .intro-banner__chars {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
  }

  .intro-char {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.2em;
    height: 1.1em;
    border-inline: 1px solid transparent;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: clamp(38px, 7.4vh, 70px);
    font-weight: 800;
    line-height: 1;
    opacity: 0;
    text-shadow: 0 0 24px rgba(255, 143, 190, 0.35),
      0 0 8px rgba(108, 201, 255, 0.25);
    will-change: transform, opacity;
  }

  :global([data-theme="dark"]) .intro-char {
    color: var(--accent);
    text-shadow: 3px 0 0 rgba(255, 176, 32, 0.5),
      -3px 0 0 rgba(0, 229, 255, 0.5), 0 0 26px rgba(0, 229, 255, 0.45);
  }

  .intro-char:nth-child(odd) {
    justify-content: flex-start;
    border-left-color: var(--accent-2);
    animation: char-in-left 0.48s calc(0.18s + var(--i) * 0.075s)
      cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-char:nth-child(even) {
    justify-content: flex-end;
    border-right-color: var(--accent-3);
    animation: char-in-right 0.48s calc(0.18s + var(--i) * 0.075s)
      cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global([data-theme="dark"]) .intro-char:nth-child(even) {
    border-right-color: var(--accent);
  }

  /* The personal profile that replaces it */
  .intro-profile {
    position: relative;
    z-index: 2;
    width: min(100%, 560px);
    padding: 24px clamp(20px, 5vw, 42px) 28px;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: radial-gradient(
      ellipse at 50% 42%,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(255, 255, 255, 0.68) 46%,
      rgba(255, 255, 255, 0) 74%
    );
    box-shadow: none;
    text-align: center;
    opacity: 0;
    transform: scale(0.94);
    backdrop-filter: none;
    animation: profile-in 0.82s 1.48s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-profile::before {
    content: "✦";
    position: absolute;
    top: 16px;
    right: 22px;
    color: var(--accent-2);
    font-size: 18px;
    text-shadow: 0 0 12px rgba(255, 143, 190, 0.8);
  }

  .intro-profile::after {
    content: "✧";
    position: absolute;
    bottom: 14px;
    left: 20px;
    color: var(--accent-3);
    font-size: 14px;
  }

  :global([data-theme="dark"]) .intro-profile {
    border: 0;
    border-radius: 0;
    background: radial-gradient(
      ellipse at 50% 42%,
      rgba(5, 10, 16, 0.94) 0%,
      rgba(5, 10, 16, 0.68) 46%,
      rgba(5, 10, 16, 0) 76%
    );
    box-shadow: none;
  }

  :global([data-theme="dark"]) .intro-profile::before {
    content: "// SYS.ONLINE";
    top: 12px;
    right: auto;
    left: 18px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
  }

  :global([data-theme="dark"]) .intro-profile::after {
    bottom: 0;
    left: 20%;
    width: 60%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent),
      var(--accent-2),
      transparent
    );
    opacity: 0.7;
  }

  .intro-profile__avatar-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 24px;
    isolation: isolate;
  }

  .intro-profile__avatar-wrap::before {
    content: "";
    position: absolute;
    inset: -7px;
    z-index: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 180deg,
      var(--accent-2),
      var(--accent-3),
      var(--accent),
      var(--accent-2)
    );
    box-shadow: 0 0 30px rgba(255, 143, 190, 0.35);
    opacity: 0;
    animation: glow-in 0.9s 1.55s ease both;
  }

  :global([data-theme="dark"]) .intro-profile__avatar-wrap::before {
    box-shadow: 0 0 34px rgba(0, 229, 255, 0.35);
  }

  .intro-profile__avatar {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 5px solid var(--surface);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 16px 50px rgba(124, 92, 255, 0.25);
    opacity: 0;
    transform: rotate(-6deg) translateY(20px);
    animation: avatar-in 0.78s 1.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global([data-theme="dark"]) .intro-profile__avatar {
    border-color: #05060a;
    box-shadow: 0 0 34px rgba(0, 229, 255, 0.25);
  }

  .intro-profile__status {
    position: absolute;
    right: 0;
    bottom: 2px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: 13px;
    line-height: 1;
    opacity: 0;
    animation: fade-in 0.4s 2.05s ease both;
  }

  :global([data-theme="dark"]) .intro-profile__status {
    border-color: rgba(0, 229, 255, 0.35);
    background: #05060a;
    box-shadow: 0 0 16px rgba(0, 229, 255, 0.25);
  }

  .intro-burst {
    position: absolute;
    inset: -12px;
    pointer-events: none;
    opacity: 0;
    animation: burst-fade 0.9s 1.52s ease both;
  }

  .intro-ray {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: 1px;
    height: 9px;
    border-radius: 1px;
    background: var(--accent-2);
    opacity: 0;
    transform-origin: 0 0;
    transform: rotate(var(--a)) translateY(-56px) scaleY(0.4);
    animation: ray-out 0.75s calc(1.5s + var(--i) * 0.018s) ease-out both;
  }

  :global([data-theme="dark"]) .intro-ray {
    background: var(--accent);
  }

  .intro-profile__eyebrow {
    display: inline-flex;
    align-items: center;
    margin: 0 0 12px;
    padding: 4px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    animation: rise-in 0.6s 1.62s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global([data-theme="dark"]) .intro-profile__eyebrow {
    border-color: rgba(0, 229, 255, 0.28);
    background: rgba(0, 229, 255, 0.06);
    box-shadow: 0 0 14px rgba(0, 229, 255, 0.1);
  }

  .intro-profile__name {
    margin: 0 0 4px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-family: var(--font-serif);
    font-size: clamp(52px, 8vw, 82px);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    opacity: 0;
    animation: rise-in 0.68s 1.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global([data-theme="dark"]) .intro-profile__name {
    background: linear-gradient(
      135deg,
      var(--accent),
      #ffffff 45%,
      var(--accent-2)
    );
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 0 18px rgba(0, 229, 255, 0.25));
  }

  .intro-profile__handle {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0;
    animation: rise-in 0.6s 1.78s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-profile__bio {
    max-width: 30em;
    margin: 18px auto 0;
    color: var(--text-soft);
    font-size: 15.5px;
    line-height: 1.85;
    opacity: 0;
    animation: rise-in 0.66s 1.86s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-profile__social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0;
    animation: rise-in 0.6s 1.94s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-profile__social a {
    color: var(--text-soft);
    text-underline-offset: 4px;
    transition: color 0.16s ease;
  }

  .intro-profile__social a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .intro-profile__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    opacity: 0;
    animation: rise-in 0.66s 2.02s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-hud {
    display: none;
  }

  :global([data-theme="dark"]) .intro-hud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid rgba(0, 229, 255, 0.16);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    opacity: 0;
    animation: rise-in 0.6s 2.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  :global([data-theme="dark"]) .intro-hud b {
    color: var(--accent);
    font-weight: 500;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
  }

  .intro-scroll {
    position: absolute;
    bottom: 22px;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(-50%);
    animation: fade-in 0.6s 2.2s ease both;
  }

  .intro-scroll svg {
    animation: scroll-bounce 2s ease-in-out infinite;
  }

  .intro-scroll:hover {
    color: var(--accent);
  }

  @keyframes bg-in {
    from {
      opacity: 0;
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes grid-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes line-grow {
    from {
      height: 0;
      opacity: 0;
    }
    to {
      height: clamp(44px, 12vh, 108px);
      opacity: 1;
    }
  }

  @keyframes char-in-left {
    from {
      opacity: 0;
      padding-left: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      padding-left: 0.6em;
      transform: none;
    }
  }

  @keyframes char-in-right {
    from {
      opacity: 0;
      padding-right: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      padding-right: 0.6em;
      transform: none;
    }
  }

  @keyframes banner-out {
    to {
      opacity: 0;
      transform: translateY(-18px) scale(0.98);
      visibility: hidden;
    }
  }

  @keyframes profile-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes avatar-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes glow-in {
    to {
      opacity: 1;
    }
  }

  @keyframes burst-fade {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes ray-out {
    0% {
      opacity: 0;
      transform: rotate(var(--a)) translateY(-42px) scaleY(0.3);
    }
    30% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: rotate(var(--a)) translateY(-78px) scaleY(1);
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 680px) {
    .home-intro {
      min-height: calc(100svh - 108px);
    }

    .home-intro__stage {
      padding: 52px 20px 82px;
    }

    .intro-char {
      font-size: clamp(34px, 6.6vh, 54px);
    }

    .intro-profile__avatar-wrap {
      width: 96px;
      height: 96px;
      margin-bottom: 18px;
    }

    .intro-profile__name {
      font-size: clamp(48px, 14vw, 68px);
    }

    .intro-profile__bio {
      font-size: 14.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-intro__bg,
    .home-intro__grid,
    .intro-banner,
    .intro-line,
    .intro-char,
    .intro-profile,
    .intro-burst,
    .intro-ray,
    .intro-profile__avatar-wrap::before,
    .intro-profile__avatar,
    .intro-profile__status,
    .intro-profile__eyebrow,
    .intro-profile__name,
    .intro-profile__handle,
    .intro-profile__bio,
    .intro-profile__social,
    .intro-profile__actions,
    .intro-scroll,
    .intro-scroll svg {
      animation: none !important;
    }

    .intro-banner {
      display: none;
    }

    .intro-profile,
    .intro-profile__avatar,
    .intro-profile__status,
    .intro-profile__eyebrow,
    .intro-profile__name,
    .intro-profile__handle,
    .intro-profile__bio,
    .intro-profile__social,
    .intro-profile__actions,
    .intro-scroll {
      opacity: 1;
      transform: none;
    }

    .intro-burst {
      display: none;
    }
  }
</style>
