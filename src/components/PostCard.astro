---
import type { CollectionEntry } from 'astro:content';
import { categoryMeta, formatDate, formatDateISO } from '../utils/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const category = categoryMeta(post.data.category);
const coverStyle = post.data.cover
  ? `background-image: linear-gradient(180deg, rgba(8, 12, 10, 0.08), rgba(8, 12, 10, 0.36)), url(${post.data.cover}); background-size: cover; background-position: center;`
  : undefined;
---

<article
  class:list={[
    'post-card',
    category?.slug === 'life' && 'post-card--life',
    post.data.cover && 'post-card--image',
  ]}
>
  <a class="post-card__link" href={`/blog/${post.id}/`}>
    <div class="post-card__cover" style={coverStyle} aria-hidden="true">
      <span class="post-card__cover-label">{post.data.category}</span>
      <span class="post-card__cover-char">
        {category?.short ?? post.data.category}
      </span>
    </div>

    <div class="post-card__body">
      <div class="post-card__meta">
        <time datetime={formatDateISO(post.data.pubDate)}>
          {formatDate(post.data.pubDate)}
        </time>
      </div>

      <Heading class="post-card__title">{post.data.title}</Heading>
      <p>{post.data.description}</p>

      <div class="post-card__tags">
        {post.data.tags.slice(0, 3).map((tag) => (
          <span class="post-card__tag">{tag}</span>
        ))}
      </div>
    </div>
  </a>
</article>
