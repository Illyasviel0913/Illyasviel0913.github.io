---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个页面好像不存在。" noindex>
  <div class="not-found">
    <div>
      <p class="not-found__code">404</p>
      <h1>这里什么都没有</h1>
      <p>链接可能过期了，或者这篇文章还没写。</p>
      <a class="button" href="/">回到首页</a>
    </div>
  </div>
</BaseLayout>
