---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIntro from '../components/HomeIntro.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const latestLife = posts
  .filter((post) => post.data.category === '生活动态')
  .slice(0, 4);
const latestStudy = posts
  .filter((post) => post.data.category === '学习笔记')
  .slice(0, 4);
---

<BaseLayout>
  <HomeIntro />

  <div class="container">
    {
      latestLife.length > 0 && (
        <section
          class="section"
          id="latest-life"
          aria-labelledby="latest-life-title"
        >
          <div class="section__head">
            <h2 class="section__title" id="latest-life-title">
              最近动态
            </h2>
            <a class="section__link" href="/categories/life/">
              全部动态 →
            </a>
          </div>

          <div class="post-list">
            {latestLife.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      )
    }

    {
      latestStudy.length > 0 && (
        <section
          class="section"
          id="latest-study"
          aria-labelledby="latest-study-title"
        >
          <div class="section__head">
            <h2 class="section__title" id="latest-study-title">
              最近笔记
            </h2>
            <a class="section__link" href="/categories/study/">
              全部笔记 →
            </a>
          </div>

          <div class="post-list">
            {latestStudy.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      )
    }

    <section class="section" aria-label="订阅">
      <div class="rss-strip">
        <p>
          <strong>不想错过更新？</strong>
          用 RSS 阅读器订阅，干干净净，没有算法。
        </p>
        <a href="/rss.xml">订阅 RSS →</a>
      </div>
    </section>
  </div>
</BaseLayout>
