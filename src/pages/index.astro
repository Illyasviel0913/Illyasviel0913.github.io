---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIntro from '../components/HomeIntro.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 5);
const counts = Object.fromEntries(
  CATEGORIES.map((category) => [
    category.name,
    posts.filter((post) => post.data.category === category.name).length,
  ]),
);
---

<BaseLayout>
  <HomeIntro />

  <div class="container">
    <section class="section" id="latest" aria-labelledby="latest-title">
      <div class="section__head">
        <h2 class="section__title" id="latest-title">最近动态</h2>
        <a class="section__link" href="/blog/">全部动态 →</a>
      </div>

      <div class="post-list">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="categories-title">
      <div class="section__head">
        <h2 class="section__title" id="categories-title">模块</h2>
        <a class="section__link" href="/tags/">按标签浏览 →</a>
      </div>

      <div class="category-grid">
        {
          CATEGORIES.map((category) => (
            <a class="category-card" href={`/categories/${category.slug}/`}>
              <span class="category-card__count">
                {counts[category.name] ?? 0} 篇
              </span>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-label="订阅">
      <div class="rss-strip">
        <p>
          <strong>不想错过更新？</strong>
          用 RSS 阅读器订阅，干干净净，没有算法。
        </p>
        <a href="/rss.xml">订阅 RSS →</a>
      </div>
    </section>
  </div>
</BaseLayout>
