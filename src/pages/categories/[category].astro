---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = (await getPublishedPosts()).filter(
  (post) => post.data.category === category.name,
);
---

<BaseLayout
  title={category.name}
  description={`${category.description}共 ${posts.length} 条。`}
>
  <header class:list={['category-hero', `category-hero--${category.slug}`]}>
    <div class="category-hero__bg" aria-hidden="true"></div>
    <span class="category-hero__char" aria-hidden="true">
      {category.short}
    </span>

    <div class="category-hero__inner">
      <p class="category-hero__eyebrow">MODULE / {category.slug.toUpperCase()}</p>
      <h1>{category.name}</h1>
      <p>{category.description}</p>
      <div class="category-hero__meta">
        <span>{posts.length} 条记录</span>
        <span class="dot" aria-hidden="true">·</span>
        <span>持续更新</span>
      </div>
    </div>
  </header>

  <div class="container category-body">
    <div class="filter-bar" aria-label="按分类筛选">
      <a class="chip" href="/blog/">全部</a>
      {
        CATEGORIES.map((item) => (
          <a
            class:list={[
              'chip',
              item.slug === category.slug && 'chip--active',
            ]}
            href={`/categories/${item.slug}/`}
            aria-current={item.slug === category.slug ? 'page' : undefined}
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="post-list">
      {posts.map((post) => <PostCard post={post} headingLevel={2} />)}
    </div>
  </div>
</BaseLayout>
