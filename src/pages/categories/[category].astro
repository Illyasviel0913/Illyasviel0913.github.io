---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = (await getPublishedPosts()).filter(
  (post) => post.data.category === category.name,
);
---

<BaseLayout
  title={category.name}
  description={`${category.description}共 ${posts.length} 篇。`}
>
  <div class="container">
    <header class="page-header">
      <h1>{category.name}</h1>
      <p>{category.description} 目前共 {posts.length} 篇。</p>
    </header>

    <div class="filter-bar" aria-label="按分类筛选">
      <a class="chip" href="/blog/">全部</a>
      {
        CATEGORIES.map((item) => (
          <a
            class:list={[
              'chip',
              item.slug === category.slug && 'chip--active',
            ]}
            href={`/categories/${item.slug}/`}
            aria-current={item.slug === category.slug ? 'page' : undefined}
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
